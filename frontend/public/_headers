/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; connect-src 'self' https://animeshar-backend.onrender.com

# Manifest file
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8

# Service Worker - MUST be served as JavaScript
/sw.js
  Content-Type: application/javascript; charset=utf-8

# All JS files in assets
/assets/*.js
  Content-Type: application/javascript; charset=utf-8

# All CSS files
/assets/*.css
  Content-Type: text/css; charset=utf-8

# All other .js files at root level
/*.js
  Content-Type: application/javascript; charset=utf-8